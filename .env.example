# ─────────────────────────────────────────────────────────────
#  Sao chép file này thành  .env.local  (khi chạy máy)  và điền
#  các giá trị bên dưới. Trên Vercel: Project → Settings →
#  Environment Variables → thêm từng biến rồi Redeploy.
# ─────────────────────────────────────────────────────────────

# --- Supabase (bắt buộc) -------------------------------------------------
# Lấy ở  Supabase → Project Settings → Data API  và  API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...          # "anon public" key

# --- Ai được phép đăng nhập (bắt buộc) ---------------------------------
# Danh sách email, cách nhau bằng dấu phẩy. Chỉ các email này mới vào được.
# Email phải đang dùng được (inbox không đầy) vì mã đăng nhập gửi qua email.
ALLOWED_EMAILS=ban@example.com

# --- Phân tích AI (tuỳ chọn) -----------------------------------------------
# Bỏ trống cũng được — chỉ riêng nút "Phân tích bằng AI" sẽ không chạy.
# Lấy ở  console.anthropic.com → API Keys  (tính phí theo lượt dùng).
ANTHROPIC_API_KEY=

# --- URL trang web (tuỳ chọn nhưng nên có) ------------------------------
# Địa chỉ thật sau khi deploy, để link trong email đăng nhập trỏ đúng chỗ.
# Ví dụ: https://ke-hoach-phat-trien.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
